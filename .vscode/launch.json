{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "request": "launch",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "servertype": "openocd",
            "executable": "${workspaceFolder}/build/rtos_sandbox",
            "svdFile": "${workspaceFolder}/deps/STM32CubeF4/STM32F411.svd",
            "device": "STM32F411xe",
            "interface": "swd",
            "overrideLaunchCommands": [
                "monitor reset halt"
            ],
            "configFiles": [
                "/usr/share/openocd/scripts/interface/stlink.cfg",
                "/usr/share/openocd/scripts/target/stm32f4x.cfg"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
    ]
}